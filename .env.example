# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=production

# Generator's own database (docker-compose builds DATABASE_URL from this).
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://generator:<password>@localhost:5432/generator
REDIS_URL=redis://localhost:6379/0

# SMARTTT, the only system the Generator talks to.
SMARTTT_BASE_URL=https://api.nextup.co.ke
# Must equal GENERATOR_API_KEY in SMARTTT. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTTT_API_KEY=
SMARTTT_TIMEOUT_SECONDS=60

# Solver.
DEFAULT_TIME_LIMIT_SECONDS=600
MAX_TIME_LIMIT_SECONDS=3600
SOLVER_WORKERS=8
# Must stay false in production: runs belong on the worker.
RUN_INLINE=false

# Sign-in sessions.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
IDENTITY_REFRESH_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

CORS_ORIGINS=
LOG_LEVEL=INFO
