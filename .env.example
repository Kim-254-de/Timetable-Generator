# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=production

# Generator's own database (docker-compose builds DATABASE_URL from this). Letters
# and digits only, as it goes into a URL:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://generator:<password>@localhost:5432/generator
REDIS_URL=redis://localhost:6379/0

# SMARTTT: sign-in, importing its data, and receiving each approved timetable as its master timetable.
SMARTTT_BASE_URL=https://api.nextup.co.ke
# Must equal GENERATOR_API_KEY in SMARTTT. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTTT_API_KEY=
SMARTTT_TIMEOUT_SECONDS=60

# Smart Attendance: the departments come from there (administrators create
# them), and so does what departments publish on their Teaching page, read by
# "Import published departments". One shared key both ways: it must equal
# GENERATOR_API_KEY in Attendance (generate as above), and Attendance sends it
# to read the terms and published times here (/api/integrations/attendance/*).
ATTENDANCE_BASE_URL=
ATTENDANCE_API_KEY=
ATTENDANCE_TIMEOUT_SECONDS=15
DEPARTMENT_SYNC_SECONDS=60

# Solver.
DEFAULT_TIME_LIMIT_SECONDS=600
MAX_TIME_LIMIT_SECONDS=3600
# Threads per solve: the server's core count.
SOLVER_WORKERS=8
# Must stay false in production: runs belong on the worker.
RUN_INLINE=false

# Sign-in sessions.
# Needs HTTPS in front of the web app; false only for local development.
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# How often a signed-in account is re-checked with Smart Attendance (removed = signed out).
IDENTITY_REFRESH_SECONDS=300
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

CORS_ORIGINS=
LOG_LEVEL=INFO
